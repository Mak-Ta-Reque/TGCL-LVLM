# Settings shared by every paper run (docs/paper_runs.md).
# Layer files in a subshell:  set -a; . common.env; . <dataset>.env; . <method>.env; set +a
# Exported values override the repo .env (the pipeline loads .env without override).

VLM_MODEL=google/gemma-3n-E4B-it
LAYER_PATH=model.language_model.norm
LOGIT_LENS_LAYER_SELECTION=0
SEED=1
# Gemma resizes every image/crop to 768x768: batch 48 (the code default) needs
# ~22-26 GB in steps 1 and 4, more than a 24 GB RTX 3090.
BATCH_SIZE=16
INFERENCE_BATCH_SIZE=16

# Step 1: concept discovery prompt; keep the 10 most frequent vocab concepts
PROMPT="What are the main objects/concepts in the image? List them in a comma-separated way."
IMAGE_BUDGET=-1
NUM_CONCEPT=10
MIN_IMAGES_PER_TAG=1
MAX_IMAGES_PER_TAG=1000

# Step 2: segments
IMAGE_SIZE_WIDTH=512
PATCH_SIZE=160
MASKS_PER_IMAGE=500
POSITIVE_NEGATIVE_SEGMENT=0
MASK_FULL_IMAGE=0

# Step 5: decomposition (per_tag: DECOMP_COMPONENTS per class; pooled: DECOMP_COMPONENTS_GLOBAL)
DECOMP_METHODS=snmf,simple,sae2,pca
DECOMP_COMPONENTS=2
DECOMP_COMPONENTS_GLOBAL=20
DL_ALPHA=20
CLEAN_EXAMPLE_RATIO=0.6
BAG_SIZE=900

# Steps 6-7: base evaluation = single-object images, multiple-choice explainer
SINGLE_OBJECT=1
EXPL_PROMPT_MODE=mcq
EXPL_INPUT_MODE=image
EXPL_MAX_IMAGES=-1
EVAL_TAG=
TOP_N=3
