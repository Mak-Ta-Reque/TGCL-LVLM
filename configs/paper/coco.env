# MS-COCO, the 10 most frequent categories (preprocessing/build_coco10_dataset.py
# --top-k-common 10 --download --output-dir data/coco_common10, then
# build_coco10_masked_grids.py --manifest data/coco_common10/manifest.json --output-root data/coco_common10).
INPUT_DIR=data/coco_common10/train_all
CONCEPTS_VOCAB=configs/vocab/coco_common10_vocab.txt
EXPL_CHOICES="person,chair,car,dining table,cup,bottle,bowl,handbag,truck,bench"
IMAGE_ROOT_SINGLE=data/coco_common10/val_masked
IMAGE_ROOT_GRID=data/coco_common10/val_grids
IMAGE_ROOT=${IMAGE_ROOT_SINGLE}

# concept-word alignment BERTScore: ground-truth captions per image file (scripts/build_coco_captions.py) and LLaMA-3
# phrases (tgcl/evaluation/word_alignment_phrases.py, needs access to meta-llama/Meta-Llama-3-8B-Instruct).
WORD_ALIGN_CAPTIONS_JSON=data/coco_common10/captions.json
WORD_ALIGN_PHRASES_JSON=data/coco_common10/word_alignment_phrases.json
