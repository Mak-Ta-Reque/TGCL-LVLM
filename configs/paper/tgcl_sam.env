# TGCL (ours): contrastive prompt, concept-span feature, per-class (binary)
# decomposition; segments = SAM automatic masks without the class name.
# Contrastive presence prompt (tgcl/models/constants.py: "Classify the image as either X or No X" made
# the Qwen models miss half the objects); model presets may override it. The concept feature is the
# state of the class word in the model's own answer ("X" / "No X"), decomposed per class with the
# purity filter (the original TGCL; the forced "There is a X." feature, FORCED_RESPONSE, stays optional).
PROMPT_TEMPLATE=cgdl_contains
# Centred concept matching (VLMConceptExplainer.set_centering): concepts minus their mean, answer states
# minus the mean of calibration answers on 5 training images per class. Raw cosine made one concept rank 1
# for almost every image (hub). ImageNet-5, sliding window, top-1 F1 with the predicting state (default
# EXPL_TOKEN_STATE): Gemma-3n 0.99, Qwen2.5-VL 0.996; with the state at the token 0.73 / 0.74.
EXPL_CENTER=calibration
# Step 4 asks about the BAG_SIZE largest SAM segments of a class, not a random BAG_SIZE: small
# fragments are almost never answered with the class (datasets.image_text_dataset.select_segments).
SEGMENT_SELECTION=largest
HOOK_NAMES=save_hidden_states_for_token_of_interest
MAX_NEW_TOKENS=50
DECOMP_STRATEGY=per_tag
CROP_MODE=langsam
CONCEPT_MASKS_PER_IMAGE=0
MASK_CONTEXT_PIXELS=10
INPAINTING_METHOD=telea
# TGCL's combination of the per-class concepts (scripts/sparsify_concepts.py):
# symmetric alignment (Lowdin orthogonalization: the orthonormal bank closest to
# the learned concepts, CONCEPT_ORTHO), then noise removal (each concept keeps
# its 50 % largest coordinates, CONCEPT_SPARSIFY).
CONCEPT_ORTHO=lowdin
CONCEPT_SPARSIFY=magnitude:0.5
