# Segments go to the VLM as cut: no resize to PATCH_SIZE x PATCH_SIZE and no white padding
# (which shrinks a small object inside a white frame); the model's processor sizes them.
# Gemma-3n resizes every image to 768x768 (256 visual tokens). Qwen2.5-VL keeps the native size
# and enlarges only up to QWEN_MIN_PIXELS (default 4 tokens; a median COCO SAM segment, 38 px,
# would get 6), so the minimum is raised to Gemma's 256 tokens (28 x 28 px each).
CROP_RESIZE=none
QWEN_MIN_PIXELS=200704
