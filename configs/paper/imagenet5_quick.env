# Fast test of the whole pipeline: imagenet5's 5 classes with 20 training and 20 test images per class
# and 10 grids, as JSON maps (preprocessing/build_subset.py --source data/imagenet1k --out
# data/imagenet1k/subsets/imagenet5_quick --classes "goldfish,toucan,school bus,coffee mug,acorn"
# --train-per-class 20 --test-per-class 20 --num-grids 10). One decomposition (snmf; MCD keeps pca).
INPUT_DIR=data/imagenet1k/train_all
CONCEPT_MAP=data/imagenet1k/subsets/imagenet5_quick/concepts_to_images.json
CONCEPTS_VOCAB=data/imagenet1k/subsets/imagenet5_quick/vocab.txt
NUM_CONCEPT=5
EXPL_CHOICES=
EXPL_CHOICES_FILE=data/imagenet1k/subsets/imagenet5_quick/vocab.txt
EXPL_MCQ_DISTRACTORS=0
IMAGE_ROOT_SINGLE=data/imagenet1k/subsets/imagenet5_quick/test.json
IMAGE_ROOT_GRID=data/imagenet1k/subsets/imagenet5_quick/grids.json
IMAGE_ROOT=${IMAGE_ROOT_SINGLE}
DECOMP_METHODS=snmf
