# CoX-LMM (Parekh et al., NeurIPS 2024) as run for the paper: whole image, an
# unconstrained prompt that names no class ("What are the objects in the image?",
# PROMPT_TEMPLATE=non_contrastive, 100 new tokens), the concept word in the answer,
# one pooled decomposition (no per-class dictionary). The paper's own caption
# prompt is PROMPT_TEMPLATE=llava with MAX_NEW_TOKENS=200.
PROMPT_TEMPLATE=non_contrastive
HOOK_NAMES=save_hidden_states_for_token_of_interest
MAX_NEW_TOKENS=100
DECOMP_STRATEGY=pooled
CROP_MODE=none
