# Qwen2.5-VL-7B-Instruct instead of Gemma-3n-E4B: sourced after the dataset, method
# and evaluation presets (scripts/run_experiments.py --model qwen2_5_vl_7b).
# Hidden states after the final norm, as for Gemma (Qwen2_5_VLModel.language_model.norm).
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LAYER_PATH=model.language_model.norm
# Visual tokens per image: 28x28 px each, at most 512 (tgcl/models/qwen_2_5.py).
QWEN_MAX_PIXELS=401408
# Batch sizes from a profile on one RTX 3090 (bf16 weights 15.5 GiB):
# step 4 crops/s 7.0 (1), 24.1 (16), 26.8 (32), 27.8 (64), peak <= 16.5 GiB;
# step 6 img/s 4.9 (1), 6.8 (8, 32/32 answers identical to batch 1), 6.6 (16, 30/32).
BATCH_SIZE=32
INFERENCE_BATCH_SIZE=32
EXPL_BATCH_SIZE=8
# Step-4 presence prompt: Qwen2.5-VL answers "cgdl_contains" conservatively (54 % recall on COCO
# objects); "cgdl_anywhere" gives 77 % at 5 % false positives (tgcl/models/constants.py).
PROMPT_TEMPLATE=cgdl_anywhere
