# CRAFT (Fel et al., CVPR 2023): image only (no prompt text), last input token
# of one forward pass, one pooled decomposition; sliding-window crops without
# the CLIP class-name filter.
PROMPT_TEMPLATE=null
HOOK_NAMES=save_hidden_states_given_token_idx
TOKEN_IDX=-1
MAX_NEW_TOKENS=1
DECOMP_STRATEGY=pooled
CROP_MODE=sliding_window
SLIDING_WINDOW_TAG_FILTER=0
