# Retrieval column "Combined": the image + the binary prompt naming the class
# ("Say '<class>' if the image contains '<class>', say 'no <class>' if it does not.");
# "no"/"yes" answer words are not scored. Run with --skip-to-step 6.
EVAL_TAG=combined
SINGLE_OBJECT=1
IMAGE_ROOT=${IMAGE_ROOT_SINGLE}
EXPL_INPUT_MODE=image
EXPL_PROMPT_MODE=binary
