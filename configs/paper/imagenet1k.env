# ImageNet-1k: all 1000 classes (preprocessing/build_imagenet1k_dataset.py --train-per-class 300
# --test-per-class 50, then create_grids.py --input_dir data/imagenet1k/val --output_dir
# data/imagenet1k/val_grids --n 4 --num_grids 500 --image_size 512 --seed 0).
# Class images come from the labels (CONCEPT_MAP), not from VLM tags; the explainer
# asks each image about its true class(es) plus 3 random other classes.
INPUT_DIR=data/imagenet1k/train_all
CONCEPT_MAP=data/imagenet1k/concepts_to_images.json
CONCEPTS_VOCAB=data/imagenet1k/vocab.txt
NUM_CONCEPT=1000
EXPL_CHOICES=
EXPL_CHOICES_FILE=data/imagenet1k/vocab.txt
EXPL_MCQ_DISTRACTORS=3
IMAGE_ROOT_SINGLE=data/imagenet1k/val
IMAGE_ROOT_GRID=data/imagenet1k/val_grids
IMAGE_ROOT=${IMAGE_ROOT_SINGLE}
