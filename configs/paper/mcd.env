# MCD (HU-MCD, Grobrugge et al., CVPR 2025), concept extraction only: image
# only (no prompt text), last input token of one forward pass, one pooled
# decomposition; each SAM segment shown as the full image with a black background.
PROMPT_TEMPLATE=null
HOOK_NAMES=save_hidden_states_given_token_idx
TOKEN_IDX=-1
MAX_NEW_TOKENS=1
DECOMP_STRATEGY=pooled
CROP_MODE=langsam
CONCEPT_MASKS_PER_IMAGE=0
MASK_FULL_IMAGE=1
INPAINTING_METHOD=blackout
MASK_CONTEXT_PIXELS=0
# MCD's own decomposition: PCA (concept subspaces from principal components).
DECOMP_METHODS=pca
