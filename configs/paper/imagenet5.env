# ImageNet-1k, 5 classes (two animals, a vehicle, a household object, a small natural object), as JSON maps
# into data/imagenet1k only, no image copies (preprocessing/build_subset.py --source data/imagenet1k
# --out data/imagenet1k/subsets/imagenet5 --classes "goldfish,toucan,school bus,coffee mug,acorn").
# Training images come from the labels (CONCEPT_MAP); test images and 2x2 grids are JSON lists, the
# grids composed in memory (helpers.image_refs). The explainer offers all 5 classes as choices.
INPUT_DIR=data/imagenet1k/train_all
CONCEPT_MAP=data/imagenet1k/subsets/imagenet5/concepts_to_images.json
CONCEPTS_VOCAB=data/imagenet1k/subsets/imagenet5/vocab.txt
NUM_CONCEPT=5
EXPL_CHOICES=
EXPL_CHOICES_FILE=data/imagenet1k/subsets/imagenet5/vocab.txt
EXPL_MCQ_DISTRACTORS=0
IMAGE_ROOT_SINGLE=data/imagenet1k/subsets/imagenet5/test.json
IMAGE_ROOT_GRID=data/imagenet1k/subsets/imagenet5/grids.json
IMAGE_ROOT=${IMAGE_ROOT_SINGLE}
