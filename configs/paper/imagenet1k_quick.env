# ImageNet-1k, all 1000 classes at quick size: 20 training and 10 test images per class and 100 grids, as
# JSON maps into data/imagenet1k only, no image copies (preprocessing/build_subset.py --source
# data/imagenet1k --out data/imagenet1k/subsets/imagenet1k_quick --train-per-class 20 --test-per-class 10
# --num-grids 100). The explainer asks each image about its true class plus 3 random other classes; the
# concepts it is matched against are those of all 1000 classes.
INPUT_DIR=data/imagenet1k/train_all
CONCEPT_MAP=data/imagenet1k/subsets/imagenet1k_quick/concepts_to_images.json
CONCEPTS_VOCAB=data/imagenet1k/subsets/imagenet1k_quick/vocab.txt
NUM_CONCEPT=1000
EXPL_CHOICES=
EXPL_CHOICES_FILE=data/imagenet1k/subsets/imagenet1k_quick/vocab.txt
EXPL_MCQ_DISTRACTORS=3
IMAGE_ROOT_SINGLE=data/imagenet1k/subsets/imagenet1k_quick/test.json
IMAGE_ROOT_GRID=data/imagenet1k/subsets/imagenet1k_quick/grids.json
IMAGE_ROOT=${IMAGE_ROOT_SINGLE}
# Step 4 asks the 300 largest segments per class (900 in the paper runs): step-4 time scales with it.
BAG_SIZE=300
# Centring mean over 2 training images per class: 2000 answers.
EXPL_CALIBRATION_PER_CLASS=2
DECOMP_METHODS=snmf
